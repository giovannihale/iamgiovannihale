---
import { LINKS } from '../consts';
const year = new Date().getFullYear();
---

<footer>
	<div class="wrap foot">
		<span>© {year} Giovanni Hale</span>
		<span class="links">
			<a href={LINKS.linkedin} rel="me">LinkedIn</a>
			<a href={LINKS.github} rel="me">GitHub</a>
			<a href={LINKS.youtube} rel="me">YouTube</a>
			<a href="/rss.xml">RSS</a>
		</span>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--rule);
	}
	.foot {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.75rem;
		padding-block: 1.75rem 2.5rem;
		font-family: var(--mono);
		font-size: 0.75rem;
		letter-spacing: 0.04em;
		color: var(--muted);
	}
	.links {
		display: flex;
		gap: 1.25rem;
	}
	.links a {
		color: var(--muted);
		text-decoration: none;
	}
	.links a:hover {
		color: var(--accent);
	}
</style>
