---
import Page from '../layouts/Page.astro';
import NoteList from '../components/NoteList.astro';
import { getPublishedNotes } from '../lib/notes';

const notes = (await getPublishedNotes()).slice(0, 5);
---

<Page>
	<section class="intro">
		<p class="label">Systems · Identity · Security</p>
		<h1>I learn how systems work, keep them running, and write down what I find.</h1>
		<p class="lede">
			Systems administrator with more than ten years in enterprise IT — executive support, identity,
			and endpoint management. This site is my working notebook: what I'm running, what broke, what I
			decided, and why.
		</p>
	</section>

	<section>
		<div class="section-head">
			<h2>Latest field notes</h2>
			<a class="label" href="/notes/">All notes →</a>
		</div>
		<NoteList notes={notes} />
	</section>

	<section class="now-teaser">
		<p class="label">Now</p>
		<p>
			Running Google Workspace and Intune on a remote systems contract, studying for CompTIA CySA+,
			and building this site in the open. <a href="/now/">What I'm focused on →</a>
		</p>
	</section>
</Page>

<style>
	.intro {
		padding-bottom: 3rem;
		margin-bottom: 1rem;
	}
	.intro h1 {
		max-width: 36rem;
		margin-top: 1rem;
	}
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.section-head h2 {
		margin: 0;
	}
	.section-head a {
		text-decoration: none;
	}
	.now-teaser {
		margin-top: 3.5rem;
		max-width: var(--measure);
	}
	.now-teaser .label {
		margin-bottom: 0.5rem;
	}
</style>
